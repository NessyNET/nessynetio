# Test image for the nginx contract (design 3.6.3, spike S5). Nothing from the
# repo is copied in: configs and dist/ are mounted read-only at run time so the
# unchanged files are what gets tested.
FROM ubuntu:26.04

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      nginx=1.28.3-2ubuntu1.12 curl openssl ca-certificates \
 && rm -r -f /var/lib/apt/lists/*

RUN mkdir -p /etc/letsencrypt/live/nessynet.io /var/www/letsencrypt /var/log/nginx/nessynet \
 && chown www-data:adm /var/log/nginx/nessynet \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
      -subj "/CN=nessynet.io" \
      -addext "subjectAltName=DNS:nessynet.io,DNS:www.nessynet.io" \
      -keyout /etc/letsencrypt/live/nessynet.io/privkey.pem \
      -out /etc/letsencrypt/live/nessynet.io/fullchain.pem
