---
// `whoami` window (ux 4.1, 7.14): the page h1 is `{name}.` + tagline + cursor, then the bio. The tagline accents are
// plain spans (no em/strong): colour is decoration, so the heading reads as plain text.
import Window from '../window/Window.astro';
import type { Whoami } from '../../lib/content/model.ts';
import { WHOAMI_META, WHOAMI_TITLE } from '../../lib/strings.ts';

interface Props {
  whoami: Whoami;
}

const { whoami } = Astro.props;
---
<Window id="who" title={WHOAMI_TITLE} titleTag="p" meta={WHOAMI_META}>
  <h1>{whoami.name}.{whoami.tagline !== null && <> <span class="tagline">{whoami.tagline.map((segment) => (segment.accent === undefined ? segment.text : <span class={`acc-${segment.accent}`}>{segment.text}</span>))}</span></>}<span class="cursor" aria-hidden="true"></span></h1>
  <p class="out bio">{whoami.bio}</p>
</Window>
<style>
  .tagline {
    color: var(--fg);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    vertical-align: -0.1em;
    background: var(--primary);
    margin-left: 0.15em;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .bio {
    margin: 0 0 8px;
    max-width: 72ch;
    overflow-wrap: anywhere;
  }
</style>
