---
// Source slot (ux 5.2, 7.10): a link, or plain `Source not available` (R7). In the bar the `source:` prefix is dropped
// for the text case to avoid "source: Source not available".
import Link from './Link.astro';
import type { SourceSlot } from '../lib/content/model.ts';
import { SOURCE_BAR_PREFIX, SOURCE_ROW_LABEL } from '../lib/strings.ts';

interface Props {
  value: SourceSlot;
  context: 'bar' | 'row';
}

const { value, context } = Astro.props;
---
<span class="slot-src">
  {value.kind === 'link'
    ? <>{context === 'bar' && <span class="pre">{SOURCE_BAR_PREFIX}</span>}<Link href={value.href}>{context === 'bar' ? value.label : SOURCE_ROW_LABEL}</Link></>
    : <span class="na">{value.text}</span>}
</span>
<style>
  .pre {
    color: var(--text-dim);
  }
</style>
