---
// Minecraft modpack layout (ux 4.3): INSTALL (launcher, import link with copy, RAM), the `mods.txt` window (first 5
// mods; own mods link to their project, when the model found one, and carry a `me` badge) and loader / minecraft / mods / memory stat rows.
import CopyField from '../../CopyField.astro';
import Link from '../../Link.astro';
import Window from '../../window/Window.astro';
import type { Project } from '../../../lib/content/model.ts';
import type { CategoryAccent } from '../../../lib/palette.ts';
import { INSTALL_CMD, INSTALL_TITLE, PACK_BY_ME, PACK_BY_OTHER, PACK_FULL_LIST, PACK_IMPORT_COPY_NAME, PACK_IMPORT_STEP, PACK_MODS_CAPTION, PACK_MODS_COLUMNS, PACK_MODS_TITLE, PACK_STAT, packLauncherStep, packMemory, packModsCmd, packModsMeta, packRamStep, packShowing } from '../../../lib/strings.ts';
import StepText from './StepText.astro';
import Steps from './Steps.astro';
import KvTable from './KvTable.astro';

interface Props {
  project: Project;
  region: 'install' | 'windows' | 'stat';
  accent?: CategoryAccent | 'primary' | undefined;
  repoUrl?: string | undefined;
}

// Own mods past this many go behind the full-list link.
const MAX_MODS = 5;

const { project, region, accent } = Astro.props;
const details = project.layout === 'modpack' ? project.details : undefined;
const shown = details === undefined ? [] : details.mods.slice(0, MAX_MODS);
const accentProp = accent === undefined ? {} : { accent };
---
{details !== undefined && region === 'install' && (
  <Window id="inst" title={INSTALL_TITLE} cmd={INSTALL_CMD} {...accentProp}>
    <Steps>
      <li>{packLauncherStep(details.launcher)}</li>
      <li><StepText parts={PACK_IMPORT_STEP} /><CopyField value={details.importUrl} what={PACK_IMPORT_COPY_NAME} /></li>
      <li>{packRamStep(details.memoryGb)}</li>
    </Steps>
  </Window>
)}
{details !== undefined && region === 'windows' && shown.length > 0 && (
  <Window id="mods" title={PACK_MODS_TITLE} meta={packModsMeta(details.modsTotal)} cmd={packModsCmd(MAX_MODS)} {...accentProp}>
    <KvTable caption={PACK_MODS_CAPTION} columns={PACK_MODS_COLUMNS}>
      {shown.map((mod) => (
        <tr>
          <td>{mod.path !== undefined
            ? <Link href={mod.path}>{mod.name}</Link>
            : mod.url === undefined || mod.mine ? mod.name : <Link href={mod.url}>{mod.name}</Link>}</td>
          <td>{mod.version}</td>
          <td>{mod.mine ? <span class="me">{PACK_BY_ME}</span> : PACK_BY_OTHER}</td>
        </tr>
      ))}
    </KvTable>
    <p class="more">{packShowing(shown.length, details.modsTotal)}{details.modsUrl !== undefined && <>{' '}<Link href={details.modsUrl}>{PACK_FULL_LIST}</Link></>}</p>
  </Window>
)}
{details !== undefined && region === 'stat' && (
  <>
    <tr><th scope="row">{PACK_STAT.loader}</th><td>{details.loader}</td></tr>
    <tr><th scope="row">{PACK_STAT.minecraft}</th><td>{details.gameVersions.join(', ')}</td></tr>
    <tr><th scope="row">{PACK_STAT.mods}</th><td>{details.modsTotal}</td></tr>
    <tr><th scope="row">{PACK_STAT.memory}</th><td>{packMemory(details.memoryGb)}</td></tr>
  </>
)}
<style>
  .more :global(a) {
    display: inline-block;
    padding: 2px 0;
  }
  .more {
    margin: 8px 0 0;
    color: var(--text-dim);
  }
  .me {
    color: var(--cyan);
    border: 1px solid var(--control-line);
    border-radius: 3px;
    padding: 0 6px;
    font-size: 13px;
  }
</style>
