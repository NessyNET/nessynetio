---
// Linux tool layout (ux 4.3): one INSTALL block per method with its own copy field, the `man <tool>` window (SYNOPSIS,
// COMMANDS, OPTIONS, EXAMPLE with copy), a `distros` table, and language / needs / distros stat rows.
import CopyField from '../../CopyField.astro';
import Window from '../../window/Window.astro';
import type { Project } from '../../../lib/content/model.ts';
import type { CategoryAccent } from '../../../lib/palette.ts';
import { INSTALL_CMD, INSTALL_TITLE, TOOL_DIST_CAPTION, TOOL_DIST_CMD, TOOL_DIST_COLUMNS, TOOL_DIST_TITLE, TOOL_EXAMPLE_COPY_NAME, TOOL_MAN_SECTIONS, TOOL_NO_VALUE, TOOL_STAT, TOOL_SUPPORT_WORDS, toolCommandCopyName, toolManTitle } from '../../../lib/strings.ts';
import KvTable from './KvTable.astro';

interface Props {
  project: Project;
  region: 'install' | 'windows' | 'stat';
  accent?: CategoryAccent | 'primary' | undefined;
  repoUrl?: string | undefined;
}

const { project, region, accent } = Astro.props;
const details = project.layout === 'tool' ? project.details : undefined;
const usage = details?.usage;
const supported = details === undefined ? [] : details.distros.filter((d) => d.support === 'supported').map((d) => d.name);
const accentProp = accent === undefined ? {} : { accent };
---
{details !== undefined && region === 'install' && details.install.length > 0 && (
  <Window id="inst" title={INSTALL_TITLE} cmd={INSTALL_CMD} {...accentProp}>
    {details.install.map((method) => (
      <div class="method">
        <h3>{method.method}</h3>
        <CopyField value={method.command} what={toolCommandCopyName(method.command)} />
        {method.note !== undefined && <p class="note">{method.note}</p>}
      </div>
    ))}
  </Window>
)}
{details !== undefined && usage !== undefined && region === 'windows' && (
  <>
    <Window id="man" title={toolManTitle(project.slug)} cmd={toolManTitle(project.slug)} {...accentProp}>
      <dl class="man">
        <div><dt>{TOOL_MAN_SECTIONS.synopsis}</dt><dd><code>{usage.synopsis}</code></dd></div>
        {usage.commands.length > 0 && (
          <div><dt>{TOOL_MAN_SECTIONS.commands}</dt><dd><dl class="opts">{usage.commands.map((c) => <div><dt><code>{c.name}</code></dt><dd>{c.help}</dd></div>)}</dl></dd></div>
        )}
        {usage.options.length > 0 && (
          <div><dt>{TOOL_MAN_SECTIONS.options}</dt><dd><dl class="opts">{usage.options.map((o) => <div><dt><code>{o.flag}</code></dt><dd>{o.help}</dd></div>)}</dl></dd></div>
        )}
        <div><dt>{TOOL_MAN_SECTIONS.example}</dt><dd><CopyField value={usage.example} what={TOOL_EXAMPLE_COPY_NAME} /></dd></div>
      </dl>
    </Window>
    {details.distros.length > 0 && (
      <Window id="dist" title={TOOL_DIST_TITLE} cmd={TOOL_DIST_CMD} {...accentProp}>
        <KvTable caption={TOOL_DIST_CAPTION} columns={TOOL_DIST_COLUMNS}>
          {details.distros.map((d) => <tr><td>{d.name}</td><td>{TOOL_SUPPORT_WORDS[d.support]}</td><td>{d.how ?? TOOL_NO_VALUE}</td></tr>)}
        </KvTable>
      </Window>
    )}
  </>
)}
{details !== undefined && region === 'stat' && (
  <>
    <tr><th scope="row">{TOOL_STAT.language}</th><td>{details.language}</td></tr>
    {details.needs.length > 0 && <tr><th scope="row">{TOOL_STAT.needs}</th><td>{details.needs.join(', ')}</td></tr>}
    {supported.length > 0 && <tr><th scope="row">{TOOL_STAT.distros}</th><td>{supported.join(', ')}</td></tr>}
  </>
)}
<style>
  .method + .method {
    margin-top: 12px;
  }
  h3 {
    margin: 0;
    font-size: 15px;
    color: var(--fg-bright);
  }
  .note {
    margin: 0;
    color: var(--text-dim);
  }
  .man,
  .opts {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .man > div {
    display: grid;
    grid-template-columns: 12ch minmax(0, 1fr);
    gap: 1ch;
  }
  .opts > div {
    display: grid;
    grid-template-columns: 18ch minmax(0, 1fr);
    gap: 1ch;
  }
  dt {
    color: var(--text-dim);
    overflow-wrap: anywhere;
  }
  /* Section names (SYNOPSIS, COMMANDS, ...) rank above the command and flag names nested under them. */
  .man > div > dt {
    font-weight: 800;
    color: var(--fg-bright);
  }
  dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .man > div,
    .opts > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
