---
// Shared data table of the layout windows (ux 8.5): sr-only caption, column headers with `scope="col"`, `<tr>` rows in
// the default slot. Long values wrap (ux 5.9); there is never a horizontal scroll region.
interface Props {
  caption: string;
  columns: readonly string[];
}

const { caption, columns } = Astro.props;
---
<table>
  <caption class="sr-only">{caption}</caption>
  <thead><tr>{columns.map((name) => <th scope="col">{name}</th>)}</tr></thead>
  <tbody><slot /></tbody>
</table>
<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    font-weight: 400;
    color: var(--text-dim);
    text-align: left;
    padding: 2px 16px 6px 0;
    border-bottom: 1px solid var(--border);
  }
  table :global(td) {
    padding: 7px 16px 7px 0;
    border-bottom: 1px dashed var(--border);
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  table :global(td a) {
    display: inline-block;
    padding: 2px 0;
  }
  @media (max-width: 760px) {
    th,
    table :global(td) {
      padding-right: 8px;
    }
  }
</style>
