---
// Minecraft mod layout (ux 4.3): INSTALL (loader, where to get it, mods/ folder), `versions` and `dependencies`
// tables, and loader / minecraft / side stat rows. Windows without data are omitted.
import Link from '../../Link.astro';
import Window from '../../window/Window.astro';
import type { Project } from '../../../lib/content/model.ts';
import type { CategoryAccent } from '../../../lib/palette.ts';
import { GET_OR, INSTALL_CMD, INSTALL_TITLE, MOD_DEPS_CAPTION, MOD_DEPS_CMD, MOD_DEPS_COLUMNS, MOD_DEPS_TITLE, MOD_DROP_STEP, MOD_STAT, MOD_VERSIONS_CAPTION, MOD_VERSIONS_CMD, MOD_VERSIONS_COLUMNS, MOD_VERSIONS_TITLE, modGetLead, modLoaderStep } from '../../../lib/strings.ts';
import StepText from './StepText.astro';
import KvTable from './KvTable.astro';

interface Props {
  project: Project;
  region: 'install' | 'windows' | 'stat';
  accent?: CategoryAccent | 'primary' | undefined;
  repoUrl?: string | undefined;
}

const { project, region, accent } = Astro.props;
const details = project.layout === 'mod' ? project.details : undefined;
const links = project.get.filter((entry) => entry.href !== undefined);
const accentProp = accent === undefined ? {} : { accent };
---
{details !== undefined && region === 'install' && (
  <Window id="inst" title={INSTALL_TITLE} cmd={INSTALL_CMD} {...accentProp}>
    <ol class="steps">
      <li><StepText parts={modLoaderStep(details.loader)} /></li>
      {links.length > 0 && <li>{modGetLead(project.name)}{links.map((entry, i) => <>{i > 0 && GET_OR}<Link href={entry.href ?? ''}>{entry.label}</Link></>)}.</li>}
      <li><StepText parts={MOD_DROP_STEP} /></li>
    </ol>
  </Window>
)}
{details !== undefined && region === 'windows' && (
  <>
    {details.files.length > 0 && (
      <Window id="ver" title={MOD_VERSIONS_TITLE} cmd={MOD_VERSIONS_CMD} {...accentProp}>
        <KvTable caption={MOD_VERSIONS_CAPTION} columns={MOD_VERSIONS_COLUMNS}>
          {details.files.map((file) => <tr><td>{file.game}</td><td>{file.loader}</td><td>{file.file}</td><td>{file.date}</td></tr>)}
        </KvTable>
      </Window>
    )}
    {details.dependencies.length > 0 && (
      <Window id="dep" title={MOD_DEPS_TITLE} cmd={MOD_DEPS_CMD} {...accentProp}>
        <KvTable caption={MOD_DEPS_CAPTION} columns={MOD_DEPS_COLUMNS}>
          {details.dependencies.map((dep) => (
            <tr><td>{dep.url === undefined ? dep.name : <Link href={dep.url}>{dep.name}</Link>}</td><td>{dep.need}</td><td>{dep.why}</td></tr>
          ))}
        </KvTable>
      </Window>
    )}
  </>
)}
{details !== undefined && region === 'stat' && (
  <>
    <tr><th scope="row">{MOD_STAT.loader}</th><td>{details.loader}</td></tr>
    <tr><th scope="row">{MOD_STAT.minecraft}</th><td>{details.gameVersions.join(', ')}</td></tr>
    <tr><th scope="row">{MOD_STAT.side}</th><td>{details.side}</td></tr>
  </>
)}
<style>
  .steps {
    margin: 0;
    padding-left: 3ch;
  }
  .steps li {
    padding: 3px 0;
  }
  .steps li::marker {
    color: var(--text-dim);
  }
  .steps :global(a) {
    display: inline-block;
    padding: 2px 0;
  }
</style>
