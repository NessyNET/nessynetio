---
// Region dispatcher (design 3.3.1): each layout adds its INSTALL window, its category windows and its extra stat rows
// at three fixed places on the page. To register a layout (020, 021): import its component, add one line to
// LAYOUTS naming the regions it renders (a list, or a function of the project when a region depends on content). Layout components take exactly the props below; `stat` content is `<tr>`
// rows for the stat table, `install` content is one window (this component adds the `#install` wrapper).
import type { Layout, Project } from '../../lib/content/model.ts';
import type { CategoryAccent } from '../../lib/palette.ts';
import Generic from './layouts/Generic.astro';
import Offline from './layouts/Offline.astro';
import Plugin from './layouts/Plugin.astro';
import Web from './layouts/Web.astro';

type Region = 'install' | 'windows' | 'stat';

interface Props {
  project: Project;
  region: Region;
  accent?: CategoryAccent | 'primary' | undefined;
  /** The category `repo_url`, passed on to layouts that show it (plugin INSTALL). */
  repoUrl?: string | undefined;
}

interface Registered {
  component: typeof Generic;
  /** Fixed, or decided per project (e.g. INSTALL only when the project has something to install). */
  regions: readonly Region[] | ((project: Project, repoUrl: string | undefined) => readonly Region[]);
}

const GENERIC: Registered = { component: Generic, regions: [] };
const LAYOUTS: Partial<Record<Layout, Registered>> = {
  generic: GENERIC,
  plugin: { component: Plugin, regions: (p, repoUrl) => (repoUrl !== undefined && p.get.some((g) => g.kind === 'install') ? ['install', 'stat'] : ['stat']) },
  offline: { component: Offline, regions: (p) => (p.get.some((g) => g.kind === 'download') ? ['install', 'stat'] : ['stat']) },
  web: { component: Web, regions: ['windows', 'stat'] },
};

const { project, region, accent, repoUrl } = Astro.props;
// A layout that is not registered yet falls back to the generic one, so every project still builds.
const { component: LayoutComponent, regions } = LAYOUTS[project.layout] ?? GENERIC;
const renders = (typeof regions === 'function' ? regions(project, repoUrl) : regions).includes(region);
---
{renders && region === 'install' && <div id="install"><LayoutComponent project={project} region={region} accent={accent} repoUrl={repoUrl} /></div>}
{renders && region !== 'install' && <LayoutComponent project={project} region={region} accent={accent} repoUrl={repoUrl} />}
